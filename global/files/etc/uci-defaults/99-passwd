#!/bin/sh

# These defaults are packaged into every image, so they can run after sysupgrade too.
[ -f /etc/backup/installed_packages.txt ] && exit 0

root_entry="$(sed -n '/^root:/ { p; q; }' /etc/shadow 2>/dev/null)"
[ -n "${root_entry}" ] || exit 0

root_password="${root_entry#root:}"
root_password="${root_password%%:*}"
[ -z "${root_password}" ] || exit 0

encrypt_password="$(openssl passwd -1 'mywrtadmin')" || exit 1
sed -i -e "s:^root\:[^\:]*\::root\:${encrypt_password}\::" /etc/shadow

exit 0
