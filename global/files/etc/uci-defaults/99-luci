#!/bin/sh

# Default LuCI theme: shadcn. Runs after the themes' own 30_luci-theme-* scripts.
# These defaults are packaged into every image, so they can run after sysupgrade too.
[ -f /etc/backup/installed_packages.txt ] && exit 0

[ -d /www/luci-static/shadcn ] || exit 0

uci -q set luci.main.mediaurlbase='/luci-static/shadcn'
uci -q commit luci

exit 0
